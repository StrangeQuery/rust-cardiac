    "test": "attributes/allow_arithmetic_overflow.rs",
    "chapter": "attributes",
    "feature": "`#[allow(arithmetic_overflow)]` over a sum rustc knows overflows",
    "section": "Diagnostic attributes",
    "notes": [
      "rustc folds the sum; with checks on both builds panic, with checks off both wrap as `i16` does."
    ],
    "input": "5",
    "runs": {
      "opt-level 1, overflow checks off": {
        "outcome": "Match",
        "output": "5,773",
        "cells": 9
      },
      "opt-level 1, overflow checks on": {
        "outcome": "Match",
        "output": "5,-999",
        "cells": 6
      },
      "opt-level 2, overflow checks off": {
        "outcome": "Match",
        "output": "5,773",
        "cells": 9
      },
      "opt-level 2, overflow checks on": {
        "outcome": "Match",
        "output": "5,-999",
        "cells": 6
      }
    }
  },
